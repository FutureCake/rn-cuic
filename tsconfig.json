{
    "compilerOptions": {
        "rootDir": ".",
        "paths": {
            "rn-cuic": [
                "./src/index"
            ],
            "rn-cuic/core": [
                "./src/core"
            ],
            "rn-cuic/button": [
                "./src/inputs/button/index"
            ],
            "rn-cuic/chip": [
                "./src/inputs/chip/index"
            ],
            "rn-cuic/toggle": [
                "./src/inputs/toggle/index"
            ],
            "rn-cuic/switch": [
                "./src/inputs/switch/index"
            ],
            "rn-cuic/text-area": [
                "./src/inputs/text-inputs/text-area/index"
            ],
            "rn-cuic/text-field": [
                "./src/inputs/text-inputs/text-field/index"
            ]
        },
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "customConditions": [
            "rn-cuic-source",
            "react-native-strict-api"
        ],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react-jsx",
        "lib": [
            "ESNext"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "verbatimModuleSyntax": true
    }
}