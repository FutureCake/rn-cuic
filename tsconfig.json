{
    "compilerOptions": {
        "rootDir": ".",
        "paths": {
            "rn-cuic": [
                "./src/index"
            ],
            "rn-cuic/core": [
                "./src/core"
            ],
            "rn-cuic/amitges": [
                "./src/pre-cooked/amitges"
            ],
            "rn-cuic/bottom-sheet": [
                "./src/components/overlays/bottom-sheet/index"
            ],
            "rn-cuic/button": [
                "./src/components/inputs/button/index"
            ],
            "rn-cuic/chip": [
                "./src/components/inputs/chip/index"
            ],
            "rn-cuic/chips": [
                "./src/components/inputs/chips/index"
            ],
            "rn-cuic/box": [
                "./src/components/layouts/box/index"
            ],
            "rn-cuic/stacks": [
                "./src/components/layouts/stacks/index"
            ],
            "rn-cuic/icon": [
                "./src/components/visuals/icon/index"
            ],
            "rn-cuic/surface": [
                "./src/components/visuals/surface/index"
            ],
            "rn-cuic/text": [
                "./src/components/visuals/text/index"
            ],
            "rn-cuic/modal": [
                "./src/components/overlays/modal/index"
            ],
            "rn-cuic/toggle": [
                "./src/components/inputs/toggle/index"
            ],
            "rn-cuic/switch": [
                "./src/components/inputs/switch/index"
            ],
            "rn-cuic/text-area": [
                "./src/components/inputs/text-inputs/text-area/index"
            ],
            "rn-cuic/text-field": [
                "./src/components/inputs/text-inputs/text-field/index"
            ],
        },
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "customConditions": [
            "rn-cuic-source",
            "react-native-strict-api"
        ],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react-jsx",
        "lib": [
            "ESNext"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "verbatimModuleSyntax": true
    }
}