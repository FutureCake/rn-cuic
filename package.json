{
    "name": "rn-cuic",
    "version": "0.1.0",
    "description": "customizable ui components for react native",
    "main": "./lib/module/index.js",
    "types": "./lib/typescript/src/index.d.ts",
    "exports": {
        ".": {
            "rn-cuic-source": "./src/index.tsx",
            "types": "./lib/typescript/src/index.d.ts",
            "default": "./lib/module/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "cpp",
        "*.podspec",
        "react-native.config.js",
        "!ios/build",
        "!android/build",
        "!android/gradle",
        "!android/gradlew",
        "!android/gradlew.bat",
        "!android/local.properties",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/.*"
    ],
    "scripts": {
        "example": "yarn workspace rn-cuic-example",
        "clean": "del-cli lib",
        "prepare": "bob build",
        "typecheck": "tsc",
        "lint": "eslint \"**/*.{js,ts,tsx}\"",
        "test": "jest",
        "release": "release-it --only-version"
    },
    "keywords": [
        "react-native",
        "ios",
        "android"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FutureCake/rn-cuic.git"
    },
    "author": "FutureCake <thomas.c.hoek+cuic@gmail.com> (https://www.github.com/FutureCake)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/FutureCake/rn-cuic/issues"
    },
    "homepage": "https://github.com/FutureCake/rn-cuic#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/compat": "^2.1.0",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^9.39.5",
        "@gorhom/bottom-sheet": "5.2.14",
        "@jest/globals": "^29.7.0",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-community/datetimepicker": "9.1.0",
        "@react-native-community/slider": "5.2.0",
        "@react-native/babel-preset": "0.86.3",
        "@react-native/eslint-config": "0.86.3",
        "@react-native/jest-preset": "0.86.3",
        "@react-native/metro-config": "0.86.3",
        "@release-it/conventional-changelog": "^12.0.0",
        "@storybook/addon-ondevice-actions": "10.6.2",
        "@storybook/addon-ondevice-controls": "10.6.2",
        "@storybook/react-native": "10.6.2",
        "@storybook/react-native-ui-lite": "10.6.2",
        "@types/react": "~19.2.4",
        "commitlint": "^21.2.1",
        "del-cli": "^7.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-ft-flow": "^3.0.11",
        "eslint-plugin-prettier": "^5.5.6",
        "expo": "~57.0.28",
        "hermes-eslint": "0.37.0",
        "jest": "^29.7.0",
        "lefthook": "^2.1.10",
        "prettier": "^3.9.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-builder-bob": "^0.43.2",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-svg": "15.15.4",
        "react-native-worklets": "0.10.1",
        "release-it": "^21.0.1",
        "storybook": "10.6.2",
        "turbo": "^2.10.8",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "react": "*",
        "react-native": "*",
        "react-native-gesture-handler": "^2.32.0",
        "react-native-reanimated": "^4.5.1",
        "react-native-worklets": "~0.10.1"
    },
    "resolutions": {
        "eslint-plugin-ft-flow@^2.0.1": "3.0.11"
    },
    "workspaces": [
        "example"
    ],
    "packageManager": "yarn@4.11.0",
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            [
                "module",
                {
                    "esm": true
                }
            ],
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    },
    "prettier": {
        "quoteProps": "consistent",
        "singleQuote": true,
        "tabWidth": 2,
        "trailingComma": "es5",
        "useTabs": false
    },
    "jest": {
        "preset": "@react-native/jest-preset",
        "testEnvironmentOptions": {
            "customExportConditions": [
                "require",
                "react-native",
                "<%- project.sourceCondition -%>"
            ]
        },
        "modulePathIgnorePatterns": [
            "<rootDir>/example/node_modules",
            "<rootDir>/lib/"
        ]
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ],
        "rules": {
            "subject-full-stop": [
                0
            ],
            "header-max-length": [
                1,
                "always",
                200
            ],
            "subject-case": [
                0
            ],
            "type-enum": [
                2,
                "always",
                [
                    "feat",
                    "fix",
                    "docs",
                    "style",
                    "refactor",
                    "perf",
                    "test",
                    "build",
                    "ci",
                    "chore",
                    "revert"
                ]
            ]
        }
    },
    "release-it": {
        "git": {
            "commitMessage": "chore: release ${version}",
            "tagName": "v${version}"
        },
        "npm": {
            "publish": true
        },
        "github": {
            "release": true
        },
        "plugins": {
            "@release-it/conventional-changelog": {
                "preset": {
                    "name": "angular"
                }
            }
        }
    },
    "create-react-native-library": {
        "type": "library",
        "languages": "js",
        "tools": [
            "eslint",
            "jest",
            "lefthook",
            "release-it"
        ],
        "version": "0.63.1"
    }
}